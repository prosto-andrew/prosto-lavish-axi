#!/usr/bin/env bash
# lavish-safe - launcher for the locally hardened lavish-axi build (WSL / Linux).
#
# The capabilities are removed in this tree's SOURCE, not merely disabled here.
# This launcher's job is to make sure the thing that runs is THAT tree: before every
# start it runs verify-hardening.mjs - the same checks you run by hand - and refuses
# to start when any of them fails: a missing, stale or unhardened build, a node_modules
# that npm rewrote, or a version that was never audited.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

die() { printf 'lavish-safe: %s\n' "$1" >&2; exit 1; }

[ -f "$ROOT/verify-hardening.mjs" ] || die "not a hardened lavish-axi checkout: $ROOT"

# The verifier's report goes to stderr: stdout carries only the CLI's response, which the agent parses.
node "$ROOT/verify-hardening.mjs" --quiet >&2 ||
  die "refusing to start: the checks above failed. In $ROOT run 'npx --yes pnpm@11.1.1 install --frozen-lockfile', then 'node verify-hardening.mjs'."

# Defence in depth: even though the source ignores these, keep the environment
# itself hostile to telemetry and to binding anywhere but loopback.
export LAVISH_AXI_TELEMETRY=0
export LAVISH_AXI_HOST=127.0.0.1
unset LAVISH_AXI_UMAMI_WEBSITE_ID LAVISH_AXI_UMAMI_HOST LAVISH_AXI_HTML_APP_TOKEN 2>/dev/null || true

exec node "$ROOT/dist/cli.mjs" "$@"
